^WebResourceURL_WebResourceTextEncodingName_WebResourceData_WebResourceMIMEType_WebResourceFrameName_�https://sdmntprseasia.oaiusercontent.com/files/00000000-2e20-8207-bd9f-2546414941bc/raw?se=2026-10-19T03%3A02%3A28Z&sp=r&sv=2026-02-06&sr=b&scid=cbf89807-a870-4e33-b435-f8da85425b85&skoid=6fa9748a-b7b2-4b56-a932-8c1417549c47&sktid=a48cca56-e6da-484e-a814-9c849652bcb3&skt=2026-10-18T18%3A32%3A03Z&ske=2026-10-19T18%3A32%3A03Z&sks=b&skv=2026-02-06&sig=9ilJ7WQ7GirZjquMIWrlVmyA2Qj5qgewdRdXXBT7%2B3s%3DUUTF-8O><!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="SKK Homemade Cookies — thoughtfully baked homemade cookies. Browse our selection and order via WhatsApp.">
<title>SKK Homemade Cookies | Baked with Care</title>
<style>
:root{--ivory:#f7f2e9;--paper:#fffdf8;--brown:#5d4032;--dark:#30231d;--gold:#b99a61;--muted:#7b6a5f;--line:#e5d9c9;--green:#456c4a}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--ivory);color:var(--dark);font-family:Georgia,'Times New Roman',serif}button,input,select,textarea{font:inherit}.sans{font-family:Arial,Helvetica,sans-serif}.topline{height:5px;background:var(--gold)}header{padding:22px 6vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(255,253,248,.88)}.brand{font-size:clamp(19px,3vw,28px);letter-spacing:2px;font-weight:bold;color:var(--brown)}.brand small{display:block;font:10px Arial,sans-serif;letter-spacing:3px;text-transform:uppercase;margin-top:5px;color:var(--muted)}nav{display:flex;gap:22px;font:12px Arial,sans-serif;letter-spacing:1px;text-transform:uppercase}nav a{color:var(--brown);text-decoration:none}.hero{padding:72px 6vw 66px;display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:center;max-width:1280px;margin:auto}.eyebrow{font:11px Arial,sans-serif;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-weight:bold}.hero h1{font-size:clamp(42px,6vw,76px);font-weight:normal;line-height:1.04;margin:18px 0;color:var(--brown)}.hero p{font:15px/1.8 Arial,sans-serif;color:var(--muted);max-width:470px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{display:inline-block;padding:14px 21px;text-decoration:none;border:1px solid var(--brown);background:var(--brown);color:white;font:12px Arial,sans-serif;letter-spacing:1px;text-transform:uppercase;cursor:pointer}.btn.secondary{background:transparent;color:var(--brown)}.hero-art{min-height:390px;background:linear-gradient(145deg,#e8d8bd,#f8f1e5 52%,#d9c3a1);border-radius:48% 48% 8px 8px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}.hero-art:before{content:"";position:absolute;width:70%;height:70%;border:1px solid rgba(93,64,50,.3);border-radius:50%}.hero-art:after{content:"SKK";font-size:clamp(55px,8vw,100px);letter-spacing:8px;color:rgba(93,64,50,.13);font-weight:bold}.seal{position:absolute;bottom:26px;right:20px;border-radius:50%;width:98px;height:98px;background:var(--brown);color:#fff9ed;display:flex;align-items:center;justify-content:center;text-align:center;font:10px/1.6 Arial,sans-serif;letter-spacing:2px;transform:rotate(9deg);border:1px solid var(--gold);outline:1px solid var(--gold);outline-offset:4px}.section{padding:62px 6vw;max-width:1280px;margin:auto}.section-head{text-align:center;margin-bottom:32px}.section h2{font-size:clamp(30px,4vw,44px);font-weight:normal;color:var(--brown);margin:10px 0}.section-head p{font:14px/1.7 Arial,sans-serif;color:var(--muted)}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.product{background:var(--paper);border:1px solid var(--line);padding:14px;display:flex;flex-direction:column}.product-art{aspect-ratio:4/3;background:linear-gradient(145deg,#eadbc5,#f8f1e6);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.cookie{width:100px;height:100px;border-radius:50%;background:#c79a5c;box-shadow:inset -8px -9px 0 #a87940,0 10px 20px #8a684522;position:relative}.cookie:before{content:"";position:absolute;inset:16px;border-radius:50%;border:2px dotted #8d5d34}.cookie.choc{background:#8b563b;box-shadow:inset -8px -9px 0 #68402d,0 10px 20px #8a684522}.cookie.white{background:#e7d7b8;box-shadow:inset -8px -9px 0 #c5ad85,0 10px 20px #8a684522}.cookie.oreo{background:#3f302c;box-shadow:inset -8px -9px 0 #251b18,0 10px 20px #8a684522}.cookie.almond:after{content:"";position:absolute;top:28px;left:36px;width:16px;height:37px;background:#e6c58d;border-radius:100%;transform:rotate(36deg);box-shadow:19px 8px 0 #e6c58d,-13px 14px 0 #e6c58d}.product h3{font-size:21px;font-weight:normal;color:var(--brown);margin:17px 0 8px}.product p{font:13px/1.6 Arial,sans-serif;color:var(--muted);margin:0 0 14px;min-height:42px}.product .price{font:12px Arial,sans-serif;letter-spacing:.5px;color:var(--gold);margin-top:auto;margin-bottom:14px}.product button{width:100%;padding:12px;border:1px solid var(--line);background:transparent;color:var(--brown);font:11px Arial,sans-serif;letter-spacing:1px;text-transform:uppercase;cursor:pointer}.product button:hover,.btn:hover{opacity:.85}.order-wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:34px;align-items:start}.order-note{background:var(--brown);color:#fff8ec;padding:30px}.order-note h3{font-size:28px;font-weight:normal;margin:10px 0 16px}.order-note p,.order-note li{font:13px/1.8 Arial,sans-serif;color:#eee0d0}.order-note ul{padding-left:18px}.form-card{background:var(--paper);border:1px solid var(--line);padding:28px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font:11px Arial,sans-serif;letter-spacing:1px;text-transform:uppercase;color:var(--muted)}.field input,.field select,.field textarea{width:100%;padding:12px;border:1px solid var(--line);background:#fffefa;color:var(--dark);font:14px Arial,sans-serif;border-radius:0}.field textarea{min-height:88px;resize:vertical}.helper{font:12px/1.6 Arial,sans-serif;color:var(--muted);margin:12px 0 18px}.notice{display:none;background:#edf4eb;border:1px solid #c9ddc5;color:#2d5833;padding:12px;margin-top:14px;font:13px/1.6 Arial,sans-serif}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.step{border-top:1px solid var(--gold);padding-top:17px}.step b{font-size:12px;color:var(--gold);letter-spacing:2px}.step h3{font-size:20px;font-weight:normal;color:var(--brown)}.step p{font:13px/1.7 Arial,sans-serif;color:var(--muted)}footer{padding:30px 6vw;background:#30231d;color:#f7eee0;text-align:center}footer .brand{color:#fff3df}footer p{font:12px/1.8 Arial,sans-serif;color:#d6c7b7}.small{font:11px Arial,sans-serif;color:var(--muted)}@media(max-width:760px){header{padding:18px 5vw}nav{gap:10px;font-size:10px}.hero{grid-template-columns:1fr;padding-top:45px;gap:28px}.hero-art{min-height:280px}.products{grid-template-columns:1fr 1fr}.order-wrap{grid-template-columns:1fr}.section{padding:48px 5vw}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.steps{grid-template-columns:1fr;gap:10px}}@media(max-width:420px){nav a:nth-child(2){display:none}.products{grid-template-columns:1fr 1fr}.product{padding:9px}.product h3{font-size:17px}.cookie{width:78px;height:78px}}
</style>
</head>
<body>
<div class="topline"></div>
<header><div class="brand">SKK <span style="color:var(--gold)">HOMEMADE COOKIES</span><small>Baked with care · Made to share</small></div><nav><a href="#shop">Our Cookies</a><a href="#order">Order</a><a href="#how">How it works</a></nav></header>
<main>
<section class="hero"><div><div class="eyebrow">Small batch · Homemade goodness</div><h1>A little sweetness,<br><i>made with love.</i></h1><p>Thoughtfully made homemade cookies for everyday treats, thoughtful gifts and special celebrations. Choose your favourites and send your order to us on WhatsApp.</p><div class="actions"><a class="btn" href="#shop">Explore our cookies</a><a class="btn secondary" href="#order">Place an order</a></div></div><div class="hero-art" role="img" aria-label="Elegant SKK Homemade Cookies brand illustration"><div class="seal">HOMEMADE<br>WITH CARE<br>✦ SKK ✦</div></div></section>
<section class="section" id="shop"><div class="section-head"><div class="eyebrow">The cookie collection</div><h2>Made for your moments</h2><p>Choose your favourites below. Prices and pack sizes can be added once confirmed.</p></div><div class="products">
<article class="product"><div class="product-art"><div class="cookie"></div></div><h3>Pineapple Tarts</h3><p>Buttery pastry with a sweet-tangy pineapple filling.</p><div class="price">Price / pack size: to be confirmed</div><button onclick="chooseProduct('Pineapple Tarts')">Add to order</button></article>
<article class="product"><div class="product-art"><div class="cookie"></div></div><h3>Peanut Cookies</h3><p>A classic nutty treat with a delicate, crumbly bite.</p><div class="price">Price / pack size: to be confirmed</div><button onclick="chooseProduct('Peanut Cookies')">Add to order</button></article>
<article class="product"><div class="product-art"><div class="cookie white"></div></div><h3>German Cookies</h3><p>Light, tender cookies with a melt-in-the-mouth texture.</p><div class="price">Price / pack size: to be confirmed</div><button onclick="chooseProduct('German Cookies')">Add to order</button></article>
<article class="product"><div class="product-art"><div class="cookie oreo"></div></div><h3>Oreo Cookies</h3><p>A chocolatey cookie choice for those who love a richer treat.</p><div class="price">Price / pack size: to be confirmed</div><button onclick="chooseProduct('Oreo Cookies')">Add to order</button></article>
<article class="product"><div class="product-art"><div class="cookie almond"></div></div><h3>Chocolate Almond Cookies</h3><p>Chocolate cookies with a satisfying almond crunch.</p><div class="price">Price / pack size: to be confirmed</div><button onclick="chooseProduct('Chocolate Almond Cookies')">Add to order</button></article>
<article class="product"><div class="product-art" style="background:var(--brown);color:#f7ead6;text-align:center;padding:20px"><div><div style="font-size:42px;color:var(--gold)">✦</div><div style="font-size:22px;line-height:1.35">Your next<br><i>favourite</i></div><p style="color:#e7d6c2;font-size:12px">Ask us about gift orders</p></div></div><h3>Gifting &amp; Special Orders</h3><p>Ordering for family, friends or a special occasion? Tell us what you need.</p><div class="price">Custom requests welcome</div><button onclick="document.getElementById('notes').focus()">Add a request</button></article>
</div></section>
<section class="section" id="order"><div class="section-head"><div class="eyebrow">Let's get baking</div><h2>Place your order</h2><p>Complete the form and send your order details to us through WhatsApp.</p></div><div class="order-wrap"><aside class="order-note"><div class="eyebrow" style="color:#d6b979">A note from SKK</div><h3>Fresh treats,<br><i>thoughtfully made.</i></h3><p>To help us prepare your order, please share your preferred items, quantity and collection or delivery details.</p><ul><li>We will confirm availability and final pricing with you.</li><li>Your order is not confirmed until SKK replies.</li><li>Delivery or collection arrangements are to be agreed by WhatsApp.</li></ul><p style="color:#d6b979">Currency: Malaysian Ringgit (RM)</p></aside>
<div class="form-card"><form id="orderForm"><div class="form-grid">
<div class="field"><label for="customer">Your name *</label><input id="customer" name="customer" required="" placeholder="Name for the order"></div>
<div class="field"><label for="phone">Your phone number *</label><input id="phone" name="phone" required="" type="tel" placeholder="e.g. 012-345 6789"></div>
<div class="field"><label for="product">Choose a product *</label><select id="product" name="product" required=""><option value="">Select a cookie</option><option>Pineapple Tarts</option><option>Peanut Cookies</option><option>German Cookies</option><option>Oreo Cookies</option><option>Chocolate Almond Cookies</option><option>Mixed / gifting request</option></select></div>
<div class="field"><label for="quantity">Quantity *</label><select id="quantity" name="quantity" required=""><option value="">Select quantity</option><option>1 pack</option><option>2 packs</option><option>3 packs</option><option>4 packs</option><option>5 packs</option><option>6 packs</option><option>10 packs</option><option>More than 10 packs</option></select></div>
<div class="field"><label for="date">Preferred date *</label><input id="date" name="date" type="date" required="" min="2026-10-19"></div>
<div class="field"><label for="fulfilment">Collection / delivery *</label><select id="fulfilment" name="fulfilment" required=""><option value="">Please choose</option><option>Self-collection</option><option>Delivery (subject to arrangement)</option><option>To be discussed</option></select></div>
<div class="field full"><label for="address">Delivery address (if applicable)</label><input id="address" name="address" placeholder="Address / area"></div>
<div class="field full"><label for="notes">Order notes</label><textarea id="notes" name="notes" placeholder="Flavour mix, gift message, quantity details or other requests"></textarea></div>
</div><p class="helper">Submitting this form opens WhatsApp with a prepared message. You can review it before sending. Please do not include sensitive personal information.</p><button class="btn" type="submit" style="width:100%">Send order via WhatsApp</button><div id="notice" class="notice" role="status"></div><p class="small">Prices and pack sizes are still to be confirmed. WhatsApp orders will be sent to SKK at the business number configured for this site.</p></form></div></div></section>
<section class="section" id="how"><div class="section-head"><div class="eyebrow">Simple as that</div><h2>How ordering works</h2></div><div class="steps"><div class="step"><b>01 / CHOOSE</b><h3>Pick your cookies</h3><p>Browse our collection and select the treats you would like.</p></div><div class="step"><b>02 / SEND</b><h3>Message us</h3><p>Fill in the order form. WhatsApp opens with your details ready to send.</p></div><div class="step"><b>03 / CONFIRM</b><h3>We confirm with you</h3><p>We will reply to confirm stock, price, payment and collection or delivery arrangements.</p></div></div></section>
</main><footer><div class="brand">SKK HOMEMADE COOKIES</div><p>Baked with care · Made to share</p><p>For orders and enquiries, contact us on WhatsApp.</p><p>© <span id="year">2026</span> SKK Homemade Cookies</p></footer>
<script>
// SETUP: Replace this with your WhatsApp number including country code, digits only.
// Malaysia example format: 60123456789 (do not include +, spaces or hyphens).
const WHATSAPP_NUMBER = "60163725055"; // SKK Homemade Cookies WhatsApp Business number
function chooseProduct(name){document.getElementById('product').value=name;document.getElementById('order').scrollIntoView({behavior:'smooth'});}
document.getElementById('year').textContent=new Date().getFullYear();
const dateInput=document.getElementById('date');const today=new Date();const localToday=new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().slice(0,10);dateInput.min=localToday;
document.getElementById('orderForm').addEventListener('submit',function(e){e.preventDefault();const d=new FormData(e.target);const number=WHATSAPP_NUMBER; if(!/^\d{8,15}$/.test(number)||number==='60123456789'){const n=document.getElementById('notice');n.style.display='block';n.textContent='The WhatsApp number needs checking in the website file. Your order details have not been sent.';return;}const lines=['Hello SKK Homemade Cookies! I would like to place an order.','','Name: '+d.get('customer'),'Customer phone: '+d.get('phone'),'Product: '+d.get('product'),'Quantity: '+d.get('quantity'),'Preferred date: '+d.get('date'),'Collection / delivery: '+d.get('fulfilment'),'Address / area: '+(d.get('address')||'Not provided'),'Order notes: '+(d.get('notes')||'None'),'','Please confirm availability, final price and payment / collection details.'];window.open('https://wa.me/'+number+'?text='+encodeURIComponent(lines.join('\n')),'_blank','noopener');});
</script>

</body></html>Ytext/htmlP␀␀␀␀(␀7␀U␀g␀}␀�'-@?@I␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀@J